<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.embrith.home"
    android:versionCode="1"
    android:versionName="1.3.1">
    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="25" />
    <!-- the pull-down status panel is a window in front of every app -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- screen time widgets -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- memory management: kill background processes of user apps -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- make EmbrithIME the default input method (priv-app only) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- General > Time zone (priv-app only) -->
    <uses-permission android:name="android.permission.SET_TIME_ZONE" />
    <!-- library: list the books of the Android storage, keep the reading state in /sdcard/Embrith/library (granted by the host with pm grant) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- directBootAware: at "system ready" the user is not unlocked yet. PackageManager then only offers Direct Boot aware components
         for the HOME intent. The stock image got through that with Settings' FallbackHome; this slim image has no Settings, so
         without this flag the system reports "No home screen found" and nothing is ever drawn. -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/embrith_icon"
        android:theme="@style/Plain"
        android:allowBackup="false"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true">

        <activity
            android:name=".HomeActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service android:name=".StatusService" android:exported="false" />
        <service android:name=".EmbrithIME" android:label="Embrith 键盘" android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <activity android:name=".MenuActivity" android:label="设置" android:screenOrientation="portrait" />
        <activity android:name=".PanelActivity" android:label="下拉面板" android:screenOrientation="portrait" android:theme="@style/PlainPanel"
            android:excludeFromRecents="true" />
        <activity android:name=".GestureActivity" android:label="手势" android:screenOrientation="portrait" />
        <activity android:name=".SlotOrderActivity" android:label="组件设置" android:screenOrientation="portrait" />
        <activity android:name="com.embrith.library.LibraryActivity" android:label="书库" android:screenOrientation="portrait" />
        <activity android:name="com.embrith.library.FolderPickActivity" android:label="选择文件夹" android:screenOrientation="portrait" />
        <activity android:name="com.embrith.library.ReaderActivity" android:label="阅读" android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize|density|fontScale" />
        <activity android:name="com.embrith.library.ComicActivity" android:label="漫画" android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize|density|fontScale" />
        <activity android:name=".PickApkActivity" android:label="选择 apk" android:screenOrientation="portrait" />
        <activity android:name=".ShareFoldersActivity" android:label="共享文件夹" android:screenOrientation="portrait" />
        <activity android:name=".UpdateActivity" android:label="重启并更新" android:screenOrientation="portrait" />
        <activity android:name=".BackupActivity" android:label="备份与恢复" android:screenOrientation="portrait" />
        <activity android:name=".NetUpdateActivity" android:label="检查更新" android:screenOrientation="portrait" />
        <activity android:name=".AppsActivity" android:label="应用管理" android:screenOrientation="portrait" />
        <activity android:name=".WhiteAppsActivity" android:label="阅读背景过滤" android:screenOrientation="portrait" />
        <activity android:name=".AnimAppsActivity" android:label="翻页动画" android:screenOrientation="portrait" />
        <activity android:name=".LogsActivity" android:label="生成日志" android:screenOrientation="portrait" />
        <activity android:name=".NetworkActivity" android:label="网络与蓝牙" android:screenOrientation="portrait" />
        <activity android:name=".SshActivity" android:label="SSH 远程登录" android:screenOrientation="portrait" />
        <activity android:name=".SshAuthActivity" android:label="SSH 登录方式" android:screenOrientation="portrait" />
        <activity android:name=".InfoActivity" android:label="说明" android:screenOrientation="portrait" />
        <activity android:name=".AmberScheduleActivity" android:label="色温时间设置" android:screenOrientation="portrait" />
        <activity android:name=".NetPickActivity" android:label="选择网络或设备" android:theme="@style/PlainDialog"
            android:screenOrientation="portrait" android:excludeFromRecents="true" />
        <activity android:name=".PowerMenuActivity" android:label="重启与退出" android:screenOrientation="portrait" android:theme="@style/PlainPanel"
            android:excludeFromRecents="true" android:launchMode="singleTop" />
        <activity android:name=".AccentActivity" android:label="主题色" android:screenOrientation="portrait" />
        <activity android:name=".ChoiceActivity" android:label="选择" android:screenOrientation="portrait" />
        <activity android:name=".WallpaperActivity" android:label="壁纸与锁屏" android:screenOrientation="portrait" />
        <activity android:name=".SleepActivity" android:label="休眠" android:screenOrientation="portrait"
            android:excludeFromRecents="true" android:launchMode="singleTop" />
        <activity android:name=".DexoptActivity" android:label="优化应用" android:screenOrientation="portrait"
            android:excludeFromRecents="true" android:launchMode="singleTask" />
        <activity android:name=".UsbActivity" android:label="USB 连接" android:screenOrientation="portrait"
            android:excludeFromRecents="true" android:launchMode="singleTask" />
    </application>
</manifest>
